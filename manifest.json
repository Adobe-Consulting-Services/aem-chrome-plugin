{
  "name": "AEM Chrome Plug-in",
  "version": "2.0.0",
  "manifest_version": 3,
  "description": "Devtools panel for AEM development. Includes an in-browser Sling Log Tracer client.",
  "devtools_page": "devtools.html",
  "options_page": "options.html",
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "icons": {
    "16": "assets/images/aem-chrome-plugin_logo_16x16.png",
    "48": "assets/images/aem-chrome-plugin_logo_48x48.png",
    "128": "assets/images/aem-chrome-plugin_logo_128x128.png"
  }
}
